+++ b/agent/retired_anthropic_models.py
@@ -0,0 +1,72 @@
+"""Map retired Anthropic API model IDs to supported replacements.
+
+Anthropic retires dated model snapshots (e.g. claude-3-5-sonnet-20241022 on
+2025-10-28). Long-lived configs and docs may still reference them; rewriting
+at normalization time stops not_found_error spam and matches Anthropic's
+published replacement table (claude-sonnet-4-6 for 3.5/3.7 Sonnet families).
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+from typing import Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+# Exact API / config IDs (lowercase keys) -> Anthropic native replacement ID.
+_RETIRED_TO_REPLACEMENT: dict[str, str] = {
+    "claude-3-5-sonnet-20240620": "claude-sonnet-4-6",
+    "claude-3-5-sonnet-20241022": "claude-sonnet-4-6",
+    "claude-3-7-sonnet-20250219": "claude-sonnet-4-6",
+    "claude-3-5-haiku-20241022": "claude-haiku-4-5-20251001",
+    "claude-3-haiku-20240307": "claude-haiku-4-5-20251001",
+    # Bedrock-style IDs (dots); preserve dot notation for Bedrock callers.
+    "anthropic.claude-3-5-sonnet-20240620-v1:0": "anthropic.claude-sonnet-4-6",
+    "anthropic.claude-3-5-sonnet-20241022-v2:0": "anthropic.claude-sonnet-4-6",
+}
+
+# Aggregator slugs (OpenRouter / Nous) use dots in the model segment.
+_AGGREGATOR_RETIRED: dict[str, str] = {
+    "anthropic/claude-3-5-sonnet-20241022": "anthropic/claude-sonnet-4.6",
+    "anthropic/claude-3-5-sonnet-20240620": "anthropic/claude-sonnet-4.6",
+    "anthropic/claude-3-7-sonnet-20250219": "anthropic/claude-sonnet-4.6",
+    "anthropic/claude-3-5-haiku-20241022": "anthropic/claude-haiku-4.5",
+}
+
+
+def _match_retired(model: str) -> Optional[str]:
+    key = model.strip().lower()
+    if key in _RETIRED_TO_REPLACEMENT:
+        return _RETIRED_TO_REPLACEMENT[key]
+    if key in _AGGREGATOR_RETIRED:
+        return _AGGREGATOR_RETIRED[key]
+    return None
+
+
+def upgrade_retired_anthropic_model(model: str) -> Tuple[str, bool]:
+    """If *model* is a known retired Anthropic id, return the replacement.
+
+    Returns (possibly_new_model, was_upgraded).
+    """
+    if not model or not model.strip():
+        return model, False
+
+    original = model.strip()
+    replacement = _match_retired(original)
+    if not replacement:
+        return original, False
+
+    logger.warning(
+        "Anthropic model %r is retired; upgrading to %r. "
+        "Update model.default in ~/.hermes/config.yaml to silence this.",
+        original,
+        replacement,
+    )
+    return replacement, True
+
+
+def list_retired_anthropic_model_ids() -> Tuple[str, ...]:
+    """Retired ids Hermes will auto-upgrade (for docs and audit scripts)."""
+    ids = set(_RETIRED_TO_REPLACEMENT.keys()) | set(_AGGREGATOR_RETIRED.keys())
+    return tuple(sorted(ids))

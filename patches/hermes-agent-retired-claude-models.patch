@@ -0,0 +1,36 @@
+"""Tests for retired Anthropic model auto-upgrade."""
+
+from agent.retired_anthropic_models import (
+    list_retired_anthropic_model_ids,
+    upgrade_retired_anthropic_model,
+)
+from hermes_cli.model_normalize import normalize_model_for_provider
+
+
+def test_upgrade_sonnet_35_oct_2024():
+    new, ok = upgrade_retired_anthropic_model("claude-3-5-sonnet-20241022")
+    assert ok
+    assert new == "claude-sonnet-4-6"
+
+
+def test_upgrade_openrouter_slug():
+    new, ok = upgrade_retired_anthropic_model("anthropic/claude-3-5-sonnet-20241022")
+    assert ok
+    assert new == "anthropic/claude-sonnet-4.6"
+
+
+def test_no_op_for_current_model():
+    new, ok = upgrade_retired_anthropic_model("claude-sonnet-4-6")
+    assert not ok
+    assert new == "claude-sonnet-4-6"
+
+
+def test_normalize_applies_upgrade_for_anthropic():
+    assert (
+        normalize_model_for_provider("claude-3-5-sonnet-20241022", "anthropic")
+        == "claude-sonnet-4-6"
+    )
+
+
+def test_retired_list_includes_oct_2024_sonnet():
+    assert "claude-3-5-sonnet-20241022" in list_retired_anthropic_model_ids()

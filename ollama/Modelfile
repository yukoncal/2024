# Cursor-friendly alias for Qwen3.5 9B.
# Cursor can reject model names that contain ":" or "." — this alias avoids that.
FROM qwen3.5:9b

# Reasonable coding defaults; raise num_ctx if you have VRAM/RAM headroom.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER num_ctx 8192
PARAMETER num_predict 4096
